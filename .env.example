# ==============================================================================
# SincronizaMEI - Configurações do Ambiente (Local/Dev)
# Copie este arquivo para .env e coloque credenciais com forte entropia
# Nunca comite seu arquivo .env original para o Git!
# ==============================================================================

# BANCO DE DADOS (PostgreSQL)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# CACHE E SESSÃO (Redis)
REDIS_PASSWORD=your_secure_redis_password_here

# MENSAGERIA (RabbitMQ)
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# CRIPTOGRAFIA (Vault/AES GCM local fallback)
AES_SECRET_KEY=sua_chave_aes_256_base64_aqui
